#!/usr/bin/python3 -I
"""The only way to build or test Mail. Never run a bare `swift build` or `swift test`.

  scripts/safe build [swift build args]   debug build by default, 2 jobs, 20 min limit
  scripts/safe selftest                   build (above), then .build/debug/MailApp --selftest, 5 min limit
  scripts/safe exec <seconds> -- <cmd>    any command under the same caps (build.sh uses it)

Caps: background priority (taskpolicy -b + nice 19), one run at a time (lock), refuses to start when the
Mac is busy or a swift build is already alive, and a timeout kills the whole process group.
Overrides for checking the wrapper itself: SAFE_LOAD_MAX, SAFE_LOCK, SAFE_BUILD_TIMEOUT, SAFE_TEST_TIMEOUT.
"""
import os, signal, subprocess, sys, time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOCK = os.environ.get("SAFE_LOCK", os.path.join(ROOT, ".build-safe.lock"))
LOAD_MAX = float(os.environ.get("SAFE_LOAD_MAX", "4"))        # half of this Mac's 8 cores
BUILD_T = int(os.environ.get("SAFE_BUILD_TIMEOUT", "1200"))
TEST_T = int(os.environ.get("SAFE_TEST_TIMEOUT", "300"))
BUSY = ["swift-build", "swift-frontend", "swift-test", "swift-driver", "xcodebuild", "xctest"]

def die(msg, code=2):
    print("safe: " + msg, file=sys.stderr); sys.exit(code)

def alive(pid):
    try: os.kill(pid, 0); return True
    except ProcessLookupError: return False
    except PermissionError: return True

def take_lock():
    for _ in range(2):
        try:
            os.mkdir(LOCK); open(LOCK + "/pid", "w").write(str(os.getpid())); return
        except FileExistsError:
            try: pid = int(open(LOCK + "/pid").read())
            except Exception: pid = 0
            if pid and alive(pid): die("another Mail build/test is running (pid %d); not starting a second one" % pid)
            subprocess.run(["rm", "-rf", LOCK])            # stale lock from a dead run
    die("could not take the lock")

def precheck():
    load = os.getloadavg()[0]
    if load > LOAD_MAX: die("the Mac is busy (load %.1f, limit %.1f); try again later" % (load, LOAD_MAX))
    for name in BUSY:
        if subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0:
            die("%s is already running; not starting another build/test" % name)

def run(cmd, limit):
    full = ["taskpolicy", "-b", "nice", "-n", "19"] + cmd
    p = subprocess.Popen(full, cwd=ROOT, start_new_session=True)
    try:
        return p.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        print("safe: TIMEOUT after %ds, killing the whole process group" % limit, file=sys.stderr)
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try: os.killpg(p.pid, sig)
            except (ProcessLookupError, PermissionError): break   # group already gone (macOS says EPERM for a zombie leader)
            time.sleep(2)
        p.wait(); return 124
    except KeyboardInterrupt:
        os.killpg(p.pid, signal.SIGKILL); return 130

def main():
    for sg in (signal.SIGTERM, signal.SIGHUP): signal.signal(sg, signal.default_int_handler)   # closing the terminal kills the build too
    a = sys.argv[1:]
    if not a: die(__doc__)
    if a[0] == "exec":
        if len(a) < 4 or a[2] != "--": die("usage: safe exec <seconds> -- <cmd>")
        steps = [(a[3:], int(a[1]))]
    elif a[0] in ("build", "selftest"):
        build = ["swift", "build", "-j", "2"] + (a[1:] if a[0] == "build" else [])
        steps = [(build, BUILD_T)]
        if a[0] == "selftest": steps.append(([os.path.join(ROOT, ".build/debug/MailApp"), "--selftest"], TEST_T))
    else: die(__doc__)
    precheck(); take_lock()
    try:
        for cmd, limit in steps:
            rc = run(cmd, limit)
            if rc: sys.exit(rc)
    finally:
        subprocess.run(["rm", "-rf", LOCK])
main()
