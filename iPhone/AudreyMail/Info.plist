<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GoogleClientPrefix</key>
	<string>$(GOOGLE_IOS_CLIENT_PREFIX)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.johnhesch.audreymail.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.$(GOOGLE_IOS_CLIENT_PREFIX)</string>
			</array>
		</dict>
	</array>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Audrey Mail adds the task you ask for to Reminders.</string>
	<key>NSContactsUsageDescription</key>
	<string>Audrey Mail shows the photo of a sender who is in your Contacts, when you turn on Sender pictures.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.johnhesch.audreymail.badge</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
